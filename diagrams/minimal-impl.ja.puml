@startuml
title FPGA 向け最小実装（必須コマンドだけで適合）

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontSize 17
skinparam nodesep 26
skinparam ranksep 34
skinparam RectangleBackgroundColor #E3F2FD
skinparam RectangleBorderColor #2B6CB0
skinparam RectangleBackgroundColor<<cpu>> #FFF3E0
skinparam RectangleBorderColor<<cpu>> #DD6B20
skinparam RectangleBackgroundColor<<pc>> #FFFFE0
skinparam RectangleBorderColor<<pc>> #B7791F
hide stereotype

rectangle "\n<size:30><b>PC</b></size>\n<size:14>USB-UART</size>\n" as PC <<pc>>

rectangle "UART RX\n8N1" as RX
rectangle "行パーサ\n2 文字 + CR LF" as PARSE
rectangle "コマンド比較\n9 種だけ" as DEC
rectangle "状態機械\n待機 / 自分 / 相手" as FSM
rectangle "応答生成\nMO PA +PI +VE -00" as GEN
rectangle "UART TX\n受信と独立" as TX
rectangle "思考ロジック\n（CPU 本体）" as ENGINE <<cpu>>

PC -right-> RX
RX -right-> PARSE
PARSE -right-> DEC
DEC -down-> FSM
FSM -left-> GEN
GEN -left-> TX
TX -left-> PC
RX -[hidden]down-> TX
PARSE -[hidden]down-> GEN
FSM <-down-> ENGINE

@enduml
