@startuml
title Minimal FPGA implementation (required commands only)

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam defaultFontSize 17
skinparam nodesep 26
skinparam ranksep 34
skinparam RectangleBackgroundColor #E3F2FD
skinparam RectangleBorderColor #2B6CB0
skinparam RectangleBackgroundColor<<cpu>> #FFF3E0
skinparam RectangleBorderColor<<cpu>> #DD6B20
skinparam RectangleBackgroundColor<<pc>> #FFFFE0
skinparam RectangleBorderColor<<pc>> #B7791F
hide stereotype

rectangle "\n<size:30><b>PC</b></size>\n<size:14>USB-UART</size>\n" as PC <<pc>>

rectangle "UART RX\n8N1" as RX
rectangle "Line parser\n2 chars + CR LF" as PARSE
rectangle "Command match\n9 commands" as DEC
rectangle "State machine\nidle / mine / theirs" as FSM
rectangle "Responder\nMO PA +PI +VE -00" as GEN
rectangle "UART TX\nindependent of RX" as TX
rectangle "Search logic\n(the CPU itself)" as ENGINE <<cpu>>

PC -right-> RX
RX -right-> PARSE
PARSE -right-> DEC
DEC -down-> FSM
FSM -left-> GEN
GEN -left-> TX
TX -left-> PC
RX -[hidden]down-> TX
PARSE -[hidden]down-> GEN
FSM <-down-> ENGINE

@enduml
